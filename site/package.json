{
  "name": "docsite-kit-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "文档站基础包的自述站：用基础包搭，内容是基础包自己的说明；它是站点骨架的正本，gwb-docsite 插件建站用的模板从这里的 app/ 与根目录配置派生",
  "docsite": {
    "features": []
  },
  "scripts": {
    "dev": "react-router dev --port 4430 --host 127.0.0.1 --strictPort",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check": "react-router typegen && tsc --noEmit && pnpm lint",
    "lint": "oxlint . --deny-warnings"
  },
  "dependencies": {
    "@fumadocs/base-ui": "catalog:",
    "@godcreator/docsite-comments": "workspace:^",
    "@godcreator/docsite-identity": "workspace:^",
    "@godcreator/docsite-page-sources": "workspace:^",
    "@godcreator/docsite-ui": "workspace:^",
    "@godcreator/docsite-writing": "workspace:^",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "isbot": "catalog:",
    "katex": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "rehype-katex": "catalog:",
    "remark-math": "catalog:",
    "@godcreator/docsite-explainer": "workspace:^",
    "@godcreator/docsite-kit": "workspace:^"
  },
  "devDependencies": {
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}

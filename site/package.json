{
  "name": "docsite-kit-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "文档站基础包的自述站：用基础包搭，内容是基础包自己的说明；app/ 与根目录的配置由 pnpm site:skeleton 照基础包的模板生成",
  "docsite": {
    "features": []
  },
  "scripts": {
    "dev": "react-router dev --port 4430 --host 127.0.0.1 --strictPort",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check": "react-router typegen && tsc --noEmit && pnpm lint",
    "lint": "oxlint . --deny-warnings"
  },
  "dependencies": {
    "@fumadocs/base-ui": "16.17.1",
    "@godcreator/docsite-comments": "^0.1.0",
    "@godcreator/docsite-explainer": "workspace:*",
    "@godcreator/docsite-identity": "^0.1.0",
    "@godcreator/docsite-kit": "workspace:*",
    "@godcreator/docsite-page-sources": "^0.1.0",
    "@godcreator/docsite-ui": "^0.1.0",
    "@godcreator/docsite-writing": "^0.1.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "isbot": "^5.2.2",
    "katex": "^0.16.47",
    "lucide-react": "1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}

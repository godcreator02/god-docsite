{
  "name": "god-live-doc-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "god-live-doc 的包工作区：核心、项目装配、命令行、三个格式包。文档站在 docs-site，消费方示例在邻居 examples",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "test": "pnpm run build && node --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@god-live-doc/cli": "workspace:*",
    "@god-live-doc/core": "workspace:*",
    "@god-live-doc/format-fumadocs": "workspace:*",
    "@god-live-doc/format-html": "workspace:*",
    "@god-live-doc/format-md": "workspace:*",
    "@god-live-doc/project": "workspace:*",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}

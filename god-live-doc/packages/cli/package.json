{
  "name": "@godcreator02/live-doc-cli",
  "version": "0.2.0",
  "type": "module",
  "description": "命令行：check / confirm / render / trajectory / init；随包发两份 skill 与站模板",
  "bin": {
    "livedoc": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/run.d.mts",
      "default": "./dist/run.mjs"
    },
    "./init": {
      "types": "./dist/init.d.mts",
      "default": "./dist/init.mjs"
    }
  },
  "files": [
    "dist",
    "skills",
    "template"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@godcreator02/live-doc-core": "workspace:*",
    "@godcreator02/live-doc-project": "workspace:*",
    "@godcreator02/live-doc-trajectory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}

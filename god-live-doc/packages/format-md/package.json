{
  "name": "@godcreator02/live-doc-format-md",
  "version": "0.1.0",
  "type": "module",
  "description": "md 格式包：注释记号 + 围栏展示区 + 尾注释",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@godcreator02/live-doc-core": "workspace:*",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "docfirst-workflow-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "gwb-docfirst 自己的文档站：建在文档站基础包上，用这套机制写自己的文档，引用的是本仓源码里的真实行段",
  "docsite": {
    "features": [
      "@godcreator/docfirst-site"
    ]
  },
  "scripts": {
    "dev": "react-router dev --port 4340 --host 127.0.0.1 --strictPort",
    "docfirst": "docfirst",
    "test": "vitest run",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@fumadocs/base-ui": "16.17.1",
    "@godcreator/docfirst-explainer": "workspace:*",
    "@godcreator/docfirst-site": "workspace:*",
    "@godcreator/docfirst-workflow": "workspace:*",
    "@godcreator/docsite-comments": "workspace:*",
    "@godcreator/docsite-explainer": "workspace:*",
    "@godcreator/docsite-identity": "workspace:*",
    "@godcreator/docsite-kit": "^0.3.0",
    "@godcreator/docsite-page-sources": "workspace:*",
    "@godcreator/docsite-ui": "workspace:*",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "isbot": "^5.2.2",
    "lucide-react": "1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "vitest": "^4.1.11",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}

{
  "name": "docfirst-workflow-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "gwb-docfirst 自己的文档站：建在文档站基础包上，用这套机制写自己的文档，引用的是本仓源码里的真实行段",
  "docsite": {
    "features": [
      "@godcreator/docsite-docfirst"
    ]
  },
  "scripts": {
    "dev": "react-router dev --port 4340 --host 127.0.0.1 --strictPort",
    "docfirst": "docfirst",
    "test": "vitest run",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@fumadocs/base-ui": "catalog:",
    "@godcreator/docsite-docfirst": "workspace:^",
    "@godcreator/docfirst-workflow": "workspace:^",
    "@godcreator/docsite-comments": "workspace:^",
    "@godcreator/docsite-explainer": "workspace:^",
    "@godcreator/docsite-identity": "workspace:^",
    "@godcreator/docsite-kit": "workspace:^",
    "@godcreator/docsite-page-sources": "workspace:^",
    "@godcreator/docsite-ui": "workspace:^",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "isbot": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "remark-math": "catalog:",
    "rehype-katex": "catalog:",
    "katex": "catalog:"
  },
  "devDependencies": {
    "@mdx-js/mdx": "catalog:",
    "vitest": "catalog:",
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}

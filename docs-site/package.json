{
  "name": "docfirst-workflow-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "全仓文档站：god-docsite 模板 + code-pin、trajectory、explainer 三个功能，用这套机制写自己的文档，引用的是本仓源码里的真实行段；文档维护用命令行 docfirst",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --strictPort --port 4340",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "docfirst": "docfirst",
    "doc": "docfirst check",
    "doc:confirm": "docfirst confirm",
    "doc:render": "docfirst render"
  },
  "dependencies": {
    "@fumadocs/base-ui": "catalog:",
    "@godcreator/code-pin": "workspace:^",
    "@godcreator/comments": "workspace:^",
    "@godcreator/explainer": "workspace:^",
    "@godcreator/god-docsite": "workspace:^",
    "@godcreator/identity": "workspace:^",
    "@godcreator/trajectory": "workspace:^",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "isbot": "catalog:",
    "katex": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "rehype-katex": "catalog:",
    "remark-math": "catalog:"
  },
  "devDependencies": {
    "@godcreator/docfirst": "workspace:^",
    "@mdx-js/mdx": "catalog:",
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

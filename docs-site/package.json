{
  "name": "docfirst-workflow-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "gwb-docfirst 自己的文档站：用这套机制写自己的文档，引用的是本仓源码里的真实行段",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 4310 -H 127.0.0.1",
    "start": "next start -p 4310 -H 127.0.0.1",
    "types:check": "next typegen && tsc --noEmit",
    "docfirst": "docfirst",
    "test": "vitest run"
  },
  "dependencies": {
    "@godcreator/docfirst-explainer": "workspace:*",
    "@godcreator/docfirst-workflow": "workspace:*",
    "cn": "^0.3.0",
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.17",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}

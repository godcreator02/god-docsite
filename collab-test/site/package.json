{
  "name": "collab-test-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "本仓的测试站（协作仓形态）：god-docsite 建站器建的基础站装上全部功能（collab、code-pin、trajectory、explainer），仓根 pnpm test:e2e 直接在它上面跑；协作的测试数据在上一级 collab/records/，本仓的包用 workspace 直连",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --strictPort --port 4450",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check": "pnpm typecheck"
  },
  "dependencies": {
    "@fumadocs/base-ui": "catalog:",
    "@godcreator/code-pin": "workspace:^",
    "@godcreator/collab": "workspace:^",
    "@godcreator/comments": "workspace:^",
    "@godcreator/explainer": "workspace:^",
    "@godcreator/god-docsite": "workspace:^",
    "@godcreator/identity": "workspace:^",
    "@godcreator/trajectory": "workspace:^",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "isbot": "catalog:",
    "katex": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "rehype-katex": "catalog:",
    "remark-math": "catalog:"
  },
  "devDependencies": {
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}

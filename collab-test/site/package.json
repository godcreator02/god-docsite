{
  "name": "collab-test-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "协作站的测试协作仓（docsite-kit 仓里的开发台）：用 docsite-kit 地基搭、挂 @godcreator/collab-site 功能包，测试数据在上一级 collab/records/；它是协作站功能包的正本测试场，依赖用 workspace 直连本仓的包",
  "docsite": {
    "features": [
      "@godcreator/collab-site"
    ]
  },
  "scripts": {
    "dev": "react-router dev --port 4450 --host 127.0.0.1 --strictPort",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check": "react-router typegen && tsc --noEmit && pnpm lint",
    "lint": "oxlint . --deny-warnings"
  },
  "dependencies": {
    "@fumadocs/base-ui": "catalog:",
    "@godcreator/collab-model": "workspace:^",
    "@godcreator/collab-site": "workspace:^",
    "@godcreator/docsite-comments": "workspace:^",
    "@godcreator/docsite-identity": "workspace:^",
    "@godcreator/docsite-kit": "workspace:^",
    "@godcreator/docsite-page-sources": "workspace:^",
    "@godcreator/docsite-ui": "workspace:^",
    "@godcreator/docsite-writing": "workspace:^",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "isbot": "catalog:",
    "katex": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "rehype-katex": "catalog:",
    "remark-math": "catalog:"
  },
  "devDependencies": {
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}

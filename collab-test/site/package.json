{
  "name": "collab-test-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "协作站的测试协作仓（docsite-kit 仓里的开发台）：用 docsite-kit 地基搭、挂 @godcreator/collab-site 功能包，测试数据在上一级 collab/records/；它是协作站功能包的正本测试场，依赖用 workspace 直连本仓的包",
  "docsite": {
    "features": [
      "@godcreator/collab-site"
    ]
  },
  "scripts": {
    "dev": "react-router dev --port 4450 --host 127.0.0.1 --strictPort",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check": "react-router typegen && tsc --noEmit && pnpm lint",
    "lint": "oxlint . --deny-warnings"
  },
  "dependencies": {
    "@fumadocs/base-ui": "16.17.1",
    "@godcreator/collab-model": "workspace:*",
    "@godcreator/collab-site": "workspace:*",
    "@godcreator/docsite-comments": "workspace:*",
    "@godcreator/docsite-identity": "workspace:*",
    "@godcreator/docsite-kit": "workspace:*",
    "@godcreator/docsite-page-sources": "workspace:*",
    "@godcreator/docsite-ui": "workspace:*",
    "@godcreator/docsite-writing": "workspace:*",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "isbot": "^5.2.2",
    "katex": "^0.16.47",
    "lucide-react": "1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "1.76.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}

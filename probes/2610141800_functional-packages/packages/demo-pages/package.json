{
  "name": "demo-pages",
  "version": "0.0.0",
  "description": "最小功能包（页面类）：带 loader/action 的页面、SSE 推送资源路由、页面树插件、给站点用的转发文件模板",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./site": {
      "types": "./dist/site/index.d.ts",
      "default": "./dist/site/index.js"
    },
    "./site/server": {
      "types": "./dist/site/demo.server.d.ts",
      "default": "./dist/site/demo.server.js"
    }
  },
  "files": [
    "dist",
    "src",
    "template"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@fumadocs/base-ui": "16.17.1",
    "fumadocs-core": "16.17.1",
    "react": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "peerDependenciesMeta": {
    "@fumadocs/base-ui": {
      "optional": true
    },
    "fumadocs-core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fumadocs/base-ui": "16.17.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "fumadocs-core": "16.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "typescript": "6.0.3"
  }
}

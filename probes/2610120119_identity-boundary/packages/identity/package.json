{
  "name": "@probe/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "实验包（任务 P）：人员公开形状与投影、people.json 盘协议校验与读取、宿主提供的身份码解析、写入请求的 Origin 与 as 判定、头像与身份标识组件。输入由宿主显式提供，包不读环境变量、不看 DEV 标记",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node",
      "@react-router/node"
    ],
    "rootDirs": [
      ".",
      "./.react-router/types"
    ]
  },
  "include": [
    "app",
    "content",
    "source.config.ts",
    "vite.config.ts",
    ".react-router/types/**/*",
    ".source/**/*.ts"
  ]
}

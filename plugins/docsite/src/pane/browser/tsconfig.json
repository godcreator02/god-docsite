{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // 浏览器侧没有 node 全局：不给空表 @types/node 会被自动收进来，写 process.env 也不报错
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // shadcn 添加的组件写的是 @/… 别名；TS 7 没有 baseUrl，paths 相对本文件所在目录解析
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["."]
}

{
  "name": "@godcreator/gwb-docsite",
  "version": "0.5.0",
  "description": "文档站插件：本 home 的身份码，一条命令从空目录建站、给站点加功能包（建站器与站点模板都在平台包 @godcreator/god-docsite 里，随插件的 dependencies 装在旁边），docfirst.create 建接好 docfirst 的文档站，托管站点的开发服务（常驻的站都登记在 gwb-data 的 hosted-sites 里，站点窗格列出每个站的状态、能打开与启停），往站点推数据，agent 读写站点评论的命令；说明书 docsite、docs-site、docs-writing、trajectory；别的插件注入服务 gwbDocsite 建站、加功能、登记常驻的站",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "LICENSE"
  ],
  "keywords": [
    "gwb-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/godcreator02/god-docsite.git",
    "directory": "plugins/docsite"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.build.json && tailwindcss -i src/pane/browser/styles.css -o dist/style.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/pane/browser/tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.6.1",
    "@godcreator/gwb-data": "^0.1.12",
    "@godcreator/gwb-kernel-desktop": "^0.10.1",
    "@godcreator/gwb-settings": "^0.4.0",
    "@godcreator/gwb-shell": "^0.15.1",
    "@godcreator/gwb-skills": "^0.4.12",
    "cordis": "^4.0.0-rc.10"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-shell": {
      "optional": true
    },
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "catalog:",
    "@godcreator/gwb-data": "catalog:",
    "@godcreator/gwb-kernel-desktop": "catalog:",
    "@godcreator/gwb-settings": "catalog:",
    "@godcreator/gwb-shell": "catalog:",
    "@godcreator/gwb-skills": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@types/node": "catalog:gwb-host",
    "@types/react": "catalog:gwb-host",
    "@types/react-dom": "catalog:gwb-host",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "cordis": "catalog:",
    "esbuild": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:gwb-host",
    "react-dom": "catalog:gwb-host",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@godcreator/code-pin": "workspace:^",
    "@godcreator/comments": "workspace:^",
    "@godcreator/docfirst": "workspace:^",
    "@godcreator/explainer": "workspace:^",
    "@godcreator/god-docsite": "workspace:^",
    "@godcreator/identity": "workspace:^",
    "@godcreator/trajectory": "workspace:^"
  }
}

{
  "name": "@godcreator/gwb-docsite",
  "version": "0.3.3",
  "description": "文档站的基础插件：本 home 的身份码，一条命令从空目录建站（骨架模板从自述站派生、随插件发布），托管站点的开发服务，往站点推数据，agent 读写站点评论的命令；别的插件注入服务 gwbDocsite 建站、托管自己的站点",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "template"
  ],
  "keywords": [
    "gwb-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node scripts/sync-template.mjs && node build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.6.1",
    "@godcreator/gwb-kernel-desktop": "^0.10.1",
    "@godcreator/gwb-settings": "^0.4.0",
    "@godcreator/gwb-skills": "^0.4.12",
    "cordis": "^4.0.0-rc.10"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/docsite-comments": "workspace:*",
    "@godcreator/docsite-feed": "workspace:*",
    "@godcreator/docsite-identity": "workspace:*",
    "@godcreator/docsite-kit": "workspace:*",
    "@godcreator/gwb-commands": "^0.6.1",
    "@godcreator/gwb-kernel-desktop": "^0.10.1",
    "@godcreator/gwb-settings": "^0.4.0",
    "@godcreator/gwb-skills": "^0.4.12",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

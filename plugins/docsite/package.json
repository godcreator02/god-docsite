{
  "name": "@godcreator/gwb-docsite",
  "version": "0.3.6",
  "description": "文档站的基础插件：本 home 的身份码，一条命令从空目录建站、给站点加功能包（建站器与站点模板都在平台包 @godcreator/god-docsite 里，随插件的 dependencies 装在旁边），托管站点的开发服务，往站点推数据，agent 读写站点评论的命令；别的插件注入服务 gwbDocsite 建站、加功能、托管自己的站点",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "gwb-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.6.1",
    "@godcreator/gwb-kernel-desktop": "^0.10.1",
    "@godcreator/gwb-settings": "^0.4.0",
    "@godcreator/gwb-skills": "^0.4.12",
    "cordis": "^4.0.0-rc.10"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "catalog:",
    "@godcreator/gwb-kernel-desktop": "catalog:",
    "@godcreator/gwb-settings": "catalog:",
    "@godcreator/gwb-skills": "catalog:",
    "@types/node": "catalog:gwb-host",
    "cordis": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "dependencies": {
    "@godcreator/comments": "workspace:^",
    "@godcreator/god-docsite": "workspace:^",
    "@godcreator/identity": "workspace:^"
  }
}

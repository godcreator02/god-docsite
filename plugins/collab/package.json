{
  "name": "@godcreator/gwb-collab",
  "version": "0.30.0",
  "description": "协作站的 gwb 插件：协作窗格里管理多个项目（站点交给 gwb-docsite 初始化、托管并推送通知、提交审核、自动同步），Gitea 一有事件就经实时推送取回，项目里别的仓只取回和提醒、在项目里建仓，协作仓与别的仓此刻的状态算成通知交给网站顶部的提示栏，协作窗格与网站提示栏的「复制给 AI」把这些通知写成提示词复制下来（插件不启动任何 AI），新出现的通知经 gwbQqBot 私聊主人，起了 QQ 命令的项目经 gwbQqBot 注册成 QQ 任务组；查看我的待办、建改任务与模块",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "gwb-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node build.ts && tailwindcss -i src/pane/browser/styles.css -o dist/style.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/pane/browser/tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run && node -e \"console.log('跳过慢的一级 *.slow.test.ts（pnpm test:slow）与 tests/verified/ 的已验证行为批（升 git/动对应模块/发版前/用户指定时要跑 pnpm test:verified）')\"",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "test:verified": "vitest run --config vitest.verified.config.ts"
  },
  "peerDependencies": {
    "@godcreator/gwb-data": "^0.1.12",
    "@cordisjs/plugin-timer": "^1.1.3",
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-docsite": "workspace:^",
    "@godcreator/gwb-gitea": "^0.1.17",
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-qq-bot": "^0.8.1",
    "@godcreator/gwb-settings": "^0.4.0",
    "@godcreator/gwb-shell": "^0.15.1",
    "@godcreator/gwb-skills": "^0.4.12"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-qq-bot": {
      "optional": true
    },
    "@godcreator/gwb-shell": {
      "optional": true
    },
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/collab": "workspace:^",
    "@godcreator/comments": "workspace:^",
    "@godcreator/gwb-docsite": "workspace:^",
    "@godcreator/identity": "workspace:^",
    "@godcreator/gwb-gitea": "catalog:",
    "@godcreator/gwb-qq-bot": "catalog:",
    "@godcreator/gwb-skills": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@types/node": "catalog:gwb-host",
    "@types/react": "catalog:gwb-host",
    "@types/react-dom": "catalog:gwb-host",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "cordis": "catalog:",
    "esbuild": "catalog:",
    "lucide-react": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:gwb-host",
    "react-dom": "catalog:gwb-host",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@godcreator/gwb-commands": "catalog:",
    "@godcreator/gwb-data": "catalog:",
    "@godcreator/gwb-kernel-desktop": "catalog:",
    "@godcreator/gwb-settings": "catalog:",
    "@godcreator/gwb-shell": "catalog:",
    "@cordisjs/plugin-timer": "catalog:"
  }
}

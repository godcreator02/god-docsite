      "optional": true
    },
    "@godcreator/gwb-shell": {
      "optional": true
    },
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/collab-merge-check": "workspace:*",

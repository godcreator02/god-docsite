    "@godcreator/gwb-zcode": "^0.4.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",

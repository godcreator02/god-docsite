{
  "name": "@godcreator/gwb-docfirst-workflow",
  "version": "0.11.0",
  "author": {
    "name": "godcreator"
  },
  "description": "docfirst 插件：一条建站命令 docfirst.create——建接好 docfirst 的文档站（现状、轨迹、未来三个区），认站名、选端口（4310 起、祖父目录查重），把功能包 @godcreator/docfirst-site（精确版本表在 src/deps.ts）交给 gwb-docsite 的建站服务 gwbDocsite.init：地基骨架、起始物、装依赖、探活都归它；注册 3 份说明书（对文档站执行命令的 docs-site、页面与钉码怎么写的 docs-writing、轨迹卡的 trajectory）；对本仓 packages/ 下的 npm 包零依赖，核对、确认与渲染在站目录里运行。服务无；skill 3 份；命令 1 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests --tags-filter=!slow",
    "test:all": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-docsite": "^0.3.0",
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-skills": "^0.4.5",
    "@godcreator/gwb-unit-folder": "^0.7.22"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-docsite": {
      "optional": true
    },
    "@godcreator/gwb-skills": {
      "optional": true
    },
    "@godcreator/gwb-unit-folder": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-docsite": "workspace:*",
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-shell": "^0.15.11",
    "@godcreator/gwb-skills": "^0.4.5",
    "@godcreator/gwb-unit-folder": "^0.7.22",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.27.7",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}

{
  "name": "@godcreator/gwb-docfirst-workflow",
  "version": "0.11.1",
  "author": {
    "name": "godcreator"
  },
  "description": "docfirst 插件：一条建站命令 docfirst.create——建接好 docfirst 的文档站（现状、轨迹、未来三个区）：认站名、选端口（4310 起、祖父目录查重），经 gwb-docsite 的服务 gwbDocsite 建基础站、加功能包 code-pin / trajectory / explainer，把 @godcreator/docfirst 的起始物叠到站点根、写 doc 系列脚本；那几个包是 dependencies，只按路径读版本与起始物、不 import；注册 3 份说明书（对文档站执行命令的 docs-site、页面与钉码怎么写的 docs-writing、轨迹卡的 trajectory）；核对、确认与渲染在站目录里运行。服务无；skill 3 份；命令 1 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests --tags-filter=!slow",
    "test:all": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-docsite": "workspace:^",
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-skills": "^0.4.5",
    "@godcreator/gwb-unit-folder": "^0.7.22"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-docsite": {
      "optional": true
    },
    "@godcreator/gwb-skills": {
      "optional": true
    },
    "@godcreator/gwb-unit-folder": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "catalog:",
    "@godcreator/gwb-docsite": "workspace:^",
    "@godcreator/gwb-kernel-desktop": "catalog:",
    "@godcreator/gwb-shell": "catalog:",
    "@godcreator/gwb-skills": "catalog:",
    "@godcreator/gwb-unit-folder": "catalog:",
    "@types/node": "catalog:gwb-host",
    "cordis": "catalog:",
    "esbuild": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "keywords": [
    "gwb-plugin"
  ],
  "dependencies": {
    "@godcreator/code-pin": "workspace:^",
    "@godcreator/docfirst": "workspace:^",
    "@godcreator/explainer": "workspace:^",
    "@godcreator/trajectory": "workspace:^"
  }
}

{
  "name": "@godcreator/gwb-docfirst-workflow",
  "version": "0.10.5",
  "author": {
    "name": "godcreator"
  },
  "description": "docfirst 插件：两条建站命令——docfirst.create 建接好 docfirst 的文档站（现状、轨迹、未来三个区），docfirst.create-plain 建不接 docfirst 的普通 fumadocs 站；都运行官方脚手架 create-fumadocs-app、应用本机约定（允许 esbuild 运行安装脚本、端口与只监听本机、Sarasa Mono SC 字体、站名、不提交 next dev 生成的 agent 提示文件、每页 md 声明 UTF-8）并写入文件；注册 3 份说明书（对文档站执行命令的 docs-site、页面与钉码怎么写的 docs-writing、轨迹卡的 trajectory）；对本仓 packages/ 下的 npm 包（通用包 code-pin、trajectory-disk 与 docfirst 自己的 docfirst-workflow、讲解组件包 docfirst-explainer）零依赖，核对、确认与渲染在仓里运行。服务无；skill 3 份；命令 2 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests --tags-filter=!slow",
    "test:all": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-skills": "^0.4.5",
    "@godcreator/gwb-unit-folder": "^0.7.22"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": {
      "optional": true
    },
    "@godcreator/gwb-unit-folder": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-skills": "^0.4.5",
    "@godcreator/gwb-unit-folder": "^0.7.22",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-docfirst.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}

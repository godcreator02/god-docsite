{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // 本件只有 node 半：窗格与浏览器半跟着站件走了，没有第二份 tsconfig、没有 esbuild 那一步
  "include": ["src/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}

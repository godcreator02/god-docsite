{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // 本插件只有 node 侧代码，没有窗格与浏览器侧代码，所以只有这一份 tsconfig、不用 esbuild 打包。
  // tests/fixtures/ 下是官方脚手架的输出样本，不参与类型检查
  "include": ["src/*.ts", "tests/*.ts", "vitest.config.ts"]
}

{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // node 侧、纯逻辑测试与构建脚本；窗格的浏览器侧代码由 src/client/tsconfig.json 检查。
  // tests/fixtures/ 下是官方脚手架的输出样本，不参与类型检查
  "include": ["src/*.ts", "src/client/*.ts", "tests/*.ts", "build.ts", "vitest.config.ts"]
}

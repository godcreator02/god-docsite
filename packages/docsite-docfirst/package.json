{
  "name": "@godcreator/docsite-docfirst",
  "version": "0.3.0",
  "author": {
    "name": "godcreator"
  },
  "type": "module",
  "description": "地基的 docfirst 能力包：建在文档站基础包 @godcreator/docsite-kit 上的站加它就有 docfirst——构建页面时的 remark 插件（钉码投影成带状态点的代码块、目录树、术语标注、轨迹卡链接）、MDX 组件 Term 与文件树、星轨盘 /trajectory 与卡页两条路由、侧栏入口「轨迹」与样式；template/ 的起始物与轨迹卡集合随建站写进新站",
  "exports": {
    "./routes": {
      "types": "./dist/routes.d.mts",
      "default": "./dist/routes.mjs"
    },
    "./site": {
      "types": "./dist/site.d.mts",
      "default": "./dist/site.mjs"
    },
    "./site-server": {
      "types": "./dist/site-server.d.mts",
      "default": "./dist/site-server.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "default": "./dist/content.mjs"
    },
    "./styles.css": "./styles/site.css"
  },
  "files": [
    "dist",
    "styles",
    "template"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@godcreator/docfirst-workflow": "workspace:^",
    "@godcreator/trajectory-disk": "workspace:^"
  },
  "peerDependencies": {
    "@fumadocs/base-ui": "16.17.1",
    "@godcreator/docsite-kit": "workspace:^",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@fumadocs/base-ui": "catalog:",
    "@godcreator/docsite-kit": "workspace:^",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "fumadocs-core": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-router": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  }
}

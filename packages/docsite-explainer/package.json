{
  "name": "@godcreator/docsite-explainer",
  "version": "0.1.0",
  "description": "文档站讲解组件（能力小包）：把一段讲解拆成若干帧、每帧配一句说明，用固定的控制条播放和切换。分步、动画、选情况三种外壳，面板、终端、胶囊、代码行等画帧用的零件，还有画系统接缝图的 SeamDiagram，共用一套样式。`.` 是客户端组件，`./text` 把各帧的说明转成机读版的文字，`./seam-graph` 定义接缝图并把它写成机读文字。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./seam-graph": {
      "types": "./dist/seam-graph.d.ts",
      "default": "./dist/seam-graph.js"
    },
    "./styles.css": "./styles/explain.css"
  },
  "files": [
    "dist",
    "src",
    "styles"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && pnpm lint",
    "lint": "oxlint . --deny-warnings"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@godcreator/docfirst",
  "version": "0.2.0",
  "author": {
    "name": "godcreator"
  },
  "type": "module",
  "description": "docfirst 命令行：读项目根的 docfirst.config.mjs，把 check / confirm / render / trajectory 分派给钉码（code-pin）、生成物（doc-export）、轨迹卡（trajectory）三个功能包，汇总结果、给出退出码。template/ 是文档维护的起始物（配置、生成物正本、起始页、第一张轨迹卡），建站后叠在站点根上。",
  "license": "MIT",
  "bin": {
    "docfirst": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "template",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "check": "pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@godcreator/code-pin": "workspace:^",
    "@godcreator/doc-export": "workspace:^",
    "@godcreator/trajectory": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/godcreator02/god-docsite.git",
    "directory": "packages/docfirst"
  },
  "keywords": [
    "gwb"
  ]
}

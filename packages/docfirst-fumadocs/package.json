{
  "name": "@godcreator/docfirst-fumadocs",
  "version": "0.1.0",
  "author": {"name": "godcreator"},
  "type": "module",
  "description": "把 docfirst 接到 fumadocs 站上：remark 接线、状态点与术语组件、轨迹卡集合与星轨盘服务端组件，随 docfirst 线发。",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./roster": {
      "types": "./dist/roster.d.mts",
      "default": "./dist/roster.mjs"
    },
    "./pre": {
      "types": "./dist/pre.d.mts",
      "default": "./dist/pre.mjs"
    },
    "./term": {
      "types": "./dist/term.d.mts",
      "default": "./dist/term.mjs"
    },
    "./trajectory": {
      "types": "./dist/trajectory.d.mts",
      "default": "./dist/trajectory.mjs"
    },
    "./light.css": "./styles/light.css",
    "./term.css": "./styles/term.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@godcreator/docfirst-pin": "workspace:*",
    "@godcreator/docfirst-trajectory": "workspace:*",
    "@godcreator/docfirst-workflow": "workspace:*",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "peerDependencies": {
    "fumadocs-core": ">=16",
    "fumadocs-ui": ">=16",
    "react": ">=19"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "fumadocs-core": "16.15.14",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.14",
    "react": "^19.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/god-live-doc.git"
  },
  "keywords": ["gwb"]
}

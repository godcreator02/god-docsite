{
  "name": "@godcreator/gwb-docfirst-workflow",
  "version": "0.7.7",
  "author": {
    "name": "godcreator"
  },
  "description": "docfirst 件：在刚铺好的 fumadocs 骨架上装六区与接线（docfirst.attach），挂六份流程说明书（讲机制三份加通用开发纪律三份）；对 docfirst-workflow 那个包零依赖，核对、确认与渲染都在仓里跑。服务无；skill 6 份；命令 1 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests --tags-filter=!slow",
    "test:all": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.6.0",
    "@godcreator/gwb-commands": "^0.5.0",
    "@godcreator/gwb-skills": "^0.4.5"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "^0.5.0",
    "@godcreator/gwb-kernel-desktop": "^0.6.0",
    "@godcreator/gwb-skills": "^0.4.5",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/god-live-doc.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}

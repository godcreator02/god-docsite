{
  "name": "@godcreator/gwb-docfirst-workflow",
  "version": "0.8.0",
  "author": {
    "name": "godcreator"
  },
  "description": "docfirst 插件：一条命令建一个接好 docfirst 的文档站（docfirst.create）——站点插件的 docs-site.create 跑官方脚手架并写盘，本插件给出在官方输出上增、换、删哪些文件（现状、轨迹、未来三个区）；注册 6 份说明书（讲 docfirst 的 3 份、通用开发纪律 3 份）；对 docfirst-workflow 包零依赖，核对、确认与渲染在仓里运行。服务无；skill 6 份；命令 1 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests --tags-filter=!slow",
    "test:all": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.7.2",
    "@godcreator/gwb-commands": "^0.5.0",
    "@godcreator/gwb-docs-site": "^0.6.0",
    "@godcreator/gwb-skills": "^0.4.5"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "^0.5.2",
    "@godcreator/gwb-docs-site": "link:../../../gwb-docs-site",
    "@godcreator/gwb-kernel-desktop": "^0.7.2",
    "@godcreator/gwb-skills": "^0.4.5",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/god-live-doc.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}

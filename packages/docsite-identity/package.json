{
  "name": "@godcreator/docsite-identity",
  "version": "0.1.1",
  "description": "文档站的人员与身份：people.json 的读取与校验、本机身份码找人、写入请求的身份与来源核对、头像与身份标识组件",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && pnpm lint",
    "lint": "oxlint . --deny-warnings"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}

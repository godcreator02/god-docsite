{
  "name": "@godcreator/docsite-ui",
  "version": "0.2.0",
  "description": "文档站 UI 外壳（能力小包）：侧栏分组、站内链接卡片、全宽切换、主题切换与身份标识、中文界面文字、推送通道浏览器 hook。组合点在骨架模板",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && pnpm lint",
    "lint": "oxlint . --deny-warnings"
  },
  "peerDependencies": {
    "@fumadocs/base-ui": "16.17.1",
    "@godcreator/docsite-identity": "workspace:*",
    "react": "^19.3.0",
    "fumadocs-core": "16.17.1"
  },
  "devDependencies": {
    "@fumadocs/base-ui": "16.17.1",
    "@godcreator/docsite-identity": "workspace:*",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "lucide-react": "1.54.0",
    "react": "^19.3.0",
    "react-router": "8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "fumadocs-core": "16.17.1"
  }
}

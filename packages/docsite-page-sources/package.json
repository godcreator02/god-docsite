{
  "name": "@godcreator/docsite-page-sources",
  "version": "0.0.0",
  "description": "文档站页面来源（fumadocs 原生形态）：TSX/HTML 页面做成 StaticSource 与 MDX 集合进同一棵页面树与搜索索引、中文搜索服务、content 资产的 dev 服务与 build 快照、TSX/HTML 页面正文组件",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "peerDependencies": {
    "fumadocs-core": "16.17.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "fumadocs-core": "16.17.1",
    "react": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}

{
  "name": "@godcreator/collab-site",
  "version": "0.31.2",
  "description": "课题组协作站的功能包，接在文档站基础包 @godcreator/docsite-kit 上：任务页（人员、模块甘特图、看板）、任务与模块各自那一页、项目日历与每天一篇的日志页、顶部的通知栏、页面里引用任务的 RecordLink。照基础包的功能包约定交出路由、侧栏入口、布局数据与样式，template/ 只有日志页的集合；数据模型在 @godcreator/collab-model",
  "type": "module",
  "exports": {
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./site": {
      "types": "./dist/site.d.ts",
      "default": "./dist/site.js"
    },
    "./site-server": {
      "types": "./dist/site-server.d.ts",
      "default": "./dist/site-server.js"
    },
    "./styles.css": "./styles/site.css"
  },
  "files": [
    "dist",
    "src",
    "styles",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "peerDependencies": {
    "@fumadocs/base-ui": "16.17.1",
    "@godcreator/docsite-comments": "workspace:^",
    "@godcreator/docsite-feed": "workspace:^",
    "@godcreator/docsite-identity": "workspace:^",
    "@godcreator/docsite-kit": "workspace:^",
    "@godcreator/docsite-ui": "workspace:^",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "dependencies": {
    "@godcreator/collab-model": "workspace:^",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:"
  },
  "devDependencies": {
    "@fumadocs/base-ui": "catalog:",
    "@godcreator/docsite-comments": "workspace:^",
    "@godcreator/docsite-feed": "workspace:^",
    "@godcreator/docsite-identity": "workspace:^",
    "@godcreator/docsite-kit": "workspace:^",
    "@godcreator/docsite-ui": "workspace:^",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "fumadocs-core": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

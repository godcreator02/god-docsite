{
  "name": "@godcreator/collab-site",
  "version": "0.30.3",
  "collabSiteProtocol": 8,
  "description": "课题组协作站的功能包，接在文档站基础包 @godcreator/docsite-kit 上：任务页（人员、模块甘特图、看板）、任务与模块各自那一页、项目日历与每天一篇的日志页、顶部的通知栏、页面里引用任务的 RecordLink，以及提交前的站点检查。照基础包的功能包约定交出路由、侧栏入口、布局数据与样式，template/ 只有日志页的集合；数据模型在 @godcreator/collab-model",
  "type": "module",
  "exports": {
    "./routes": {
      "types": "./dist/feature/routes.d.ts",
      "default": "./dist/feature/routes.js"
    },
    "./site": {
      "types": "./dist/feature/site.d.ts",
      "default": "./dist/feature/site.js"
    },
    "./site-server": {
      "types": "./dist/feature/site-server.d.ts",
      "default": "./dist/feature/site-server.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./site-check": {
      "types": "./dist/site-check.d.ts",
      "default": "./dist/site-check.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "peerDependencies": {
    "@fumadocs/base-ui": "16.16.2",
    "@godcreator/docsite-kit": "workspace:*",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "dependencies": {
    "@godcreator/collab-model": "workspace:*",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@fumadocs/base-ui": "16.16.2",
    "@godcreator/docsite-kit": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fumadocs-core": "16.16.2",
    "jsdom": "^30.1.1",
    "lucide-react": "1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}

{
  "name": "@godcreator/docfirst-explainer",
  "version": "0.2.0",
  "author": {
    "name": "godcreator"
  },
  "type": "module",
  "description": "讲解组件包的转发薄壳：正本已并入 docsite-kit 仓的 @godcreator/docsite-explainer，这里按原出口名（.、./text、./seam-graph、./styles.css）原样转发，装了旧包名的站不用改代码；新站直接装新包",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./text": {
      "types": "./dist/text.d.mts",
      "default": "./dist/text.mjs"
    },
    "./seam-graph": {
      "types": "./dist/seam-graph.d.mts",
      "default": "./dist/seam-graph.mjs"
    },
    "./styles.css": "./styles/explain.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "keywords": [
    "gwb"
  ],
  "dependencies": {
    "@godcreator/docsite-explainer": "^0.1.0"
  }
}

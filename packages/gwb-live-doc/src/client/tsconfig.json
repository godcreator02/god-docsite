{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // 浏览器半看不见 node 全局：不给空表的话 @types/node 会自动收进来，
    // 写一句 process.env 也不报错，而束里根本没有它
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // shadcn 式组件写的是 @/… 这种，typecheck 得解析得了。
    // 不写 baseUrl：TS 7 移除了它，paths 相对本文件所在目录解析
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["."]
}

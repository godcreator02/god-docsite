{
  "name": "@godcreator/docsite-writing",
  "version": "0.1.0",
  "description": "文档站写作组件：术语（Term 组件 + remark 标注插件，正文首现标注、hover/焦点展开定义）与 TSX 公式（Tex）；代码块/表格/Tabs 等直接用锁定版 Fumadocs 公开组件，不在这里包装",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compile": {
      "types": "./dist/compile.d.ts",
      "default": "./dist/compile.js"
    },
    "./styles.css": "./src/term.css"
  },
  "files": [
    "dist",
    "src",
    "src/term.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && pnpm lint",
    "lint": "oxlint . --deny-warnings"
  },
  "peerDependencies": {
    "katex": "^0.16.47",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/unist": "catalog:",
    "katex": "catalog:",
    "mdast-util-mdx-jsx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-math": "catalog:",
    "remark-mdx": "catalog:",
    "remark-parse": "catalog:",
    "typescript": "catalog:",
    "unified": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@godcreator/word-report",
  "version": "0.5.1",
  "author": {
    "name": "godcreator"
  },
  "type": "module",
  "description": "报告：JSON 报告文档的格式、校验与分章组装，MDX 写法编译成它（.）；读报告目录、检查、导出 Word、JSON 报告转 MDX 的命令行 report-docx（./node）；报告页与报告列表（./site），两页与图片的 loader（./site/server）；engine/ 是驱动本机 Word 的 Python 导出引擎与 .dotx 模板；template/ 是建站器复制进站点 app/features/word-report/ 的接线文件（两条页面路由、图片路由、侧栏入口、样式）。",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/core.d.mts",
      "default": "./dist/core.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./site": {
      "types": "./dist/site.d.mts",
      "default": "./dist/site.mjs"
    },
    "./site/server": {
      "types": "./dist/site-server.d.mts",
      "default": "./dist/site-server.mjs"
    },
    "./styles.css": "./styles/report.css"
  },
  "bin": {
    "report-docx": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "styles",
    "template",
    "engine/pyproject.toml",
    "engine/requirements.txt",
    "engine/README.md",
    "engine/src/docreport",
    "engine/schemas",
    "engine/templates",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@godcreator/comments": "workspace:^",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-math": "catalog:",
    "remark-mdx": "catalog:",
    "remark-parse": "catalog:",
    "sharp": "catalog:",
    "unified": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "@fumadocs/base-ui": "^16.17.1",
    "katex": "^0.16.47",
    "react": ">=19",
    "react-router": "^8.4.0"
  },
  "peerDependenciesMeta": {
    "@fumadocs/base-ui": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fumadocs/base-ui": "catalog:",
    "@react-router/dev": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "katex": "catalog:",
    "mdast-util-mdx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/godcreator02/god-docsite.git",
    "directory": "packages/word-report"
  },
  "keywords": [
    "gwb"
  ]
}

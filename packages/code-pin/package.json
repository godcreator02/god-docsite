{
  "name": "@godcreator/code-pin",
  "version": "0.1.0",
  "author": {
    "name": "godcreator"
  },
  "type": "module",
  "description": "把文字钉在代码上：只认目标（行段、整个文件、目录树）与记录，核对出代码变没变、确认出新记录；不读文件，读取器与旧内容来源由调用方传入。template/ 是建站器复制进站点 app/features/code-pin/ 的接线文件（remark 插件与样式）。",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./site": {
      "types": "./dist/site.d.mts",
      "default": "./dist/site.mjs"
    },
    "./site/pin.css": "./dist/pin.css"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@types/mdast": "catalog:",
    "diff": "catalog:",
    "mdast-util-mdx": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-math": "catalog:",
    "remark-mdx": "catalog:",
    "remark-parse": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "@mdx-js/mdx": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "keywords": [
    "gwb"
  ]
}

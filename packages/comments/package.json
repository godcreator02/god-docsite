{
  "name": "@godcreator/comments",
  "version": "0.0.0",
  "description": "文档站评论：评论文件的格式与读写、评论串整理、唯一一份评论写入 action、给页面 loader 读本页评论、评论面板与正文里的定位",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.mts",
      "default": "./dist/core/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.mts",
      "default": "./dist/node/index.mjs"
    },
    "./site": {
      "types": "./dist/site/index.d.mts",
      "default": "./dist/site/index.mjs"
    },
    "./site/server": {
      "types": "./dist/site/index.server.d.mts",
      "default": "./dist/site/index.server.mjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "lint": "oxlint . --deny-warnings"
  },
  "dependencies": {
    "@godcreator/identity": "workspace:^",
    "diff-match-patch": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/diff-match-patch": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

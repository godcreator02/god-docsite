{
  "name": "@godcreator/comments",
  "version": "0.1.7",
  "description": "文档站评论：评论文件的格式与读写、评论串整理、唯一一份评论写入 action、给页面 loader 读本页评论、本页评论的收件箱与正文下方的评论浮窗、正文里的定位、全站评论表格。template/ 是建站器复制进站点 app/features/comments/ 的接线文件（全站评论页兼评论写入的路由、侧栏入口、样式与正文高亮）",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.mts",
      "default": "./dist/core/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.mts",
      "default": "./dist/node/index.mjs"
    },
    "./site": {
      "types": "./dist/site/index.d.mts",
      "default": "./dist/site/index.mjs"
    },
    "./site/server": {
      "types": "./dist/site/index.server.d.mts",
      "default": "./dist/site/index.server.mjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "template",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/godcreator02/god-docsite.git",
    "directory": "packages/comments"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "lint": "oxlint . --deny-warnings"
  },
  "dependencies": {
    "@godcreator/identity": "workspace:^",
    "@godcreator/utc8-time": "catalog:",
    "diff-match-patch": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/diff-match-patch": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

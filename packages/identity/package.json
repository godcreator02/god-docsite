{
  "name": "@godcreator/identity",
  "version": "0.2.0",
  "description": "文档站的人员与身份：people.json 的校验与读写、按本机身份码认人、给浏览器的公开投影、写入请求的来源与身份核对、头像文件的读写与核对、站上的身份组件与头像面板。template/ 是建站器复制进站点 app/features/identity/ 的头像写入路由",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.mts",
      "default": "./dist/core/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.mts",
      "default": "./dist/node/index.mjs"
    },
    "./site": {
      "types": "./dist/site/index.d.mts",
      "default": "./dist/site/index.mjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "template",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/godcreator02/god-docsite.git",
    "directory": "packages/identity"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "lint": "oxlint . --deny-warnings"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

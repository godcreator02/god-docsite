{
  "name": "@godcreator/docfirst-workflow",
  "version": "0.3.1",
  "author": {"name": "godcreator"},
  "type": "module",
  "description": "文档站工作流工具：命令行（核对、确认、渲染、轨迹）、项目装配与 mdx 格式，随 docfirst 线发。",
  "bin": {
    "docfirst": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./mdx": {
      "types": "./dist/mdx.d.mts",
      "default": "./dist/mdx.mjs"
    },
    "./cards": {
      "types": "./dist/cards.d.mts",
      "default": "./dist/cards.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@godcreator/code-pin": "workspace:*",
    "@godcreator/trajectory-disk": "workspace:*",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/god-live-doc.git"
  },
  "keywords": ["gwb"]
}

{
  "name": "@godcreator/docfirst-workflow",
  "version": "0.2.4",
  "author": {"name": "godcreator"},
  "type": "module",
  "description": "文档站工作流工具：六区装配、钉码校验与 render（命令行 + 库），随 docfirst 线发。",
  "bin": {
    "docfirst": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./fumadocs": {
      "types": "./dist/fumadocs.d.mts",
      "default": "./dist/fumadocs.mjs"
    },
    "./fumadocs/pre": {
      "types": "./dist/pre.d.mts",
      "default": "./dist/pre.mjs"
    },
    "./fumadocs/term": {
      "types": "./dist/term.d.mts",
      "default": "./dist/term.mjs"
    },
    "./fumadocs/light.css": "./styles/light.css",
    "./fumadocs/term.css": "./styles/term.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@godcreator/docfirst-trajectory": "workspace:*",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0"
  },
  "peerDependencies": {
    "fumadocs-core": ">=16",
    "fumadocs-ui": ">=16",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "fumadocs-core": {
      "optional": true
    },
    "fumadocs-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.1",
    "react": "^19.2.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/god-live-doc.git"
  },
  "keywords": ["gwb"]
}

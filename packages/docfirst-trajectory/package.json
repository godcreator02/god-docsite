{
  "name": "@godcreator/docfirst-trajectory",
  "version": "0.1.1",
  "author": {"name": "godcreator"},
  "type": "module",
  "description": "轨迹卡核心：卡格式、建模、布局与星轨盘画布。`.` 入口是零 import 的纯函数，`./disk` 是客户端组件 StarDisk，随 docfirst 线发。",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./disk": {
      "types": "./dist/disk.d.mts",
      "default": "./dist/disk.mjs"
    },
    "./star.css": "./styles/star.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/god-live-doc.git"
  },
  "keywords": ["gwb"]
}

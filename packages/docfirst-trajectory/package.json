{
  "name": "@godcreator/docfirst-trajectory",
  "version": "0.1.1",
  "author": {"name": "godcreator"},
  "type": "module",
  "description": "轨迹卡与星轨盘：`.` 扫卡、四层校验（含 docfirst 引用记号）、聚盘建模、布局与链表纯函数（零 npm 依赖）；`./react` 客户端星轨盘组件；`./server` 服务端组件、frontmatter schema、remark 关系边插件",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./star.css": "./styles/star.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "unist-util-visit": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/god-live-doc.git"
  }
}

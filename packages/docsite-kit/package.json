{
  "name": "@godcreator/docsite-kit",
  "version": "0.1.0",
  "description": "基于 fumadocs（React Router 框架模式 + Vite）的文档站基础包：MDX、TSX、HTML 三种页面来源，开发服务插件，服务端函数，页面正文组件，评论，中文界面文字",
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./page-sources": {
      "types": "./dist/page-sources.d.ts",
      "default": "./dist/page-sources.js"
    },
    "./comments": {
      "types": "./dist/comments.d.ts",
      "default": "./dist/comments.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./files": {
      "types": "./dist/server/files.d.ts",
      "default": "./dist/server/files.js"
    },
    "./site-feed": {
      "types": "./dist/site-feed.d.ts",
      "default": "./dist/site-feed.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "peerDependencies": {
    "@fumadocs/base-ui": "16.16.2",
    "fumadocs-core": "16.16.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@fumadocs/base-ui": "16.16.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fumadocs-core": "16.16.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "diff-match-patch": "1.0.5",
    "parse5": "7.3.0",
    "yaml": "2.9.1"
  }
}

{
  "name": "@godcreator/docsite-kit",
  "version": "0.2.0",
  "description": "基于 fumadocs（React Router 框架模式 + Vite）的文档站基础包：站点模板与初始化，功能包的约定，MDX、TSX、HTML 三种页面来源，开发服务插件，服务端函数，页面正文组件，评论，中文界面文字",
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./feature": {
      "types": "./dist/feature.d.ts",
      "default": "./dist/feature.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "default": "./dist/init.js"
    },
    "./site-modules": {
      "types": "./site-modules.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "template",
    "site-modules.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/docsite-kit.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && pnpm lint",
    "lint": "oxlint . --deny-warnings"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@godcreator/docsite-page-sources": "workspace:*",
    "@godcreator/docsite-ui": "workspace:*",
    "@godcreator/docsite-feed": "workspace:*"
  }
}

{
  "name": "@godcreator02/live-doc-format-html",
  "version": "0.1.0",
  "type": "module",
  "description": "html 格式包：元素既是记号又是展示区，文件即终态",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@godcreator02/live-doc-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}

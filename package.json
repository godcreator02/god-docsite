{
  "name": "god-live-doc-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "god-live-doc 的包工作区：核心、项目装配、命令行、三个格式包、轨迹。文档站在 docs-site，它同时是这套包唯一的消费方",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck && tsc -p tsconfig.tests.json",
    "//test": "带 build 的安全默认。门禁里先单跑一次 build，之后各摊并发跑，那时用 test:only——只改测试就不必重建七个包",
    "test": "pnpm run build && pnpm run test:only",
    "test:only": "node --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@godcreator02/live-doc-cli": "workspace:*",
    "@godcreator02/live-doc-core": "workspace:*",
    "@godcreator02/live-doc-format-fumadocs": "workspace:*",
    "@godcreator02/live-doc-format-html": "workspace:*",
    "@godcreator02/live-doc-format-md": "workspace:*",
    "@godcreator02/live-doc-project": "workspace:*",
    "@godcreator02/live-doc-trajectory": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}

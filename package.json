{
  "name": "docfirst-workflow-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "docfirst 的包工作区：两个通用包（钉码 code-pin、星轨盘 trajectory-disk）与 docfirst 自己的两个包：docfirst-workflow（命令行、项目装配与格式，fumadocs 适配在它的子入口 ./fumadocs）、docfirst-explainer（docfirst 站上用的讲解组件，只有站用），外加一个工作台插件（在 plugins/docfirst）。文档站在 docs-site，它同时是这几个包唯一的使用方",
  "scripts": {
    "build": "pnpm -r --filter \"./plugins/*\" --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r --filter \"./plugins/*\" --filter \"./packages/*\" run typecheck && tsc -p tsconfig.tests.json",
    "test": "pnpm run build && pnpm run test:only",
    "test:only": "node --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@godcreator/code-pin": "workspace:*",
    "@godcreator/trajectory-disk": "workspace:*",
    "@godcreator/docfirst-workflow": "workspace:*",
    "@godcreator/docfirst-explainer": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}

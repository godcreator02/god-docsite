{
  "name": "docfirst-workflow-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "docfirst 的包工作区：一个 docfirst 包（判定 / 环境 / 格式 / 装配 / 命令行五个模块）加一个轨迹包，外加一枚工作台件。文档站在 docs-site，它同时是这两个包唯一的消费方",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck && tsc -p tsconfig.tests.json",
    "//test": "带 build 的安全默认。门禁里先单跑一次 build，之后各摊并发跑，那时用 test:only——只改测试就不必重建",
    "test": "pnpm run build && pnpm run test:only",
    "test:only": "node --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@team/docfirst-workflow": "workspace:*",
    "@team/docfirst-trajectory": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}

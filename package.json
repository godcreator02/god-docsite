{
  "name": "docfirst-workflow-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "docfirst 的包工作区：四个包（钉码 pin、轨迹 trajectory、命令行与项目 workflow、fumadocs 适配 fumadocs）与讲解组件包 docs-explain，外加一个工作台插件（在 plugins/docfirst）。文档站在 docs-site，它同时是这几个包唯一的消费方",
  "scripts": {
    "build": "pnpm -r --filter \"./plugins/*\" --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r --filter \"./plugins/*\" --filter \"./packages/*\" run typecheck && tsc -p tsconfig.tests.json",
    "test": "pnpm run build && pnpm run test:only",
    "test:only": "node --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@godcreator/docfirst-fumadocs": "workspace:*",
    "@godcreator/docfirst-pin": "workspace:*",
    "@godcreator/docfirst-trajectory": "workspace:*",
    "@godcreator/docfirst-workflow": "workspace:*",
    "@godcreator/docs-explain": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}

{
  "name": "docsite-kit-workspace",
  "private": true,
  "type": "module",
  "description": "文档站地基与 docfirst 文档工作流的 pnpm workspace：packages/ 是地基能力包、组合包 docsite-kit 与 docfirst 的包（钉码 code-pin、星轨盘 trajectory-disk、命令行 docfirst-workflow、功能包 docsite-docfirst、讲解组件薄壳 docfirst-explainer）；plugins/ 是两个 gwb 插件（docsite 基础插件与 docfirst 工作流插件）；site/ 是基础包自述站（骨架的正本），docs-site/ 是 docfirst 文档站（docfirst 站的正本）",
  "scripts": {
    "dev": "pnpm --filter docsite-kit-site dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "check": "tsc -p tsconfig.tests.json && pnpm -r --no-bail check",
    "depcheck": "depcruise \"packages/*/src\" \"plugins/*/src\" --config .dependency-cruiser.cjs --ignore-known"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@godcreator/code-pin": "workspace:^",
    "@godcreator/docfirst-workflow": "workspace:^",
    "@godcreator/trajectory-disk": "workspace:^",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dependency-cruiser": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
